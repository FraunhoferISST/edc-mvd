meta {
  name: Create consumer participant
  type: http
  seq: 1
}

post {
  url: {{ISSUER_ADMIN_URL}}/api/admin/v1alpha/participants/{{ISSUER_CONTEXT_ID}}/holders
  body: json
  auth: inherit
}

body:json {
  {
      "did": "{{CONSUMER_ID}}",
      "holderId": "{{CONSUMER_ID}}",
      "name": "{{CONSUMER_NAME}}"
  }
}

settings {
  encodeUrl: true
}

docs {
  Generated from cURL: curl -sL -X POST 'http://localhost:10013/api/admin/v1alpha/holders' \
  -H 'Content-Type: application/json' \
  -d '{ "did": "did:web:localhost%3A7083", "participantId": "did:web:localhost%3A7083", "name": "Consumer Participant"}'
}
