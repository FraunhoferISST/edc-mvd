meta {
  name: check Credential Status
  type: http
  seq: 4
}

get {
  url: {{ISSUER_ADMIN_URL}}/api/admin/v1alpha/participants/{{ISSUER_CONTEXT_ID}}/credentials/:credentialId/status
  body: none
  auth: inherit
}

params:path {
  credentialId: <string>
}

settings {
  encodeUrl: true
}

docs {
  Checks the revocation status of a credential with the given ID for the given participant.
}
