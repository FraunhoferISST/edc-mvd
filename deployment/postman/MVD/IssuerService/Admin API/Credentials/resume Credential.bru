meta {
  name: resume Credential
  type: http
  seq: 2
}

post {
  url: {{ISSUER_ADMIN_URL}}/api/admin/v1alpha/participants/{{ISSUER_CONTEXT_ID}}/credentials/:credentialId/resume
  body: none
  auth: inherit
}

params:path {
  credentialId: <string>
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
}

docs {
  Resumes a credential with the given ID for the given participant. Resumed credentials will be removed from the Revocation List.
}
