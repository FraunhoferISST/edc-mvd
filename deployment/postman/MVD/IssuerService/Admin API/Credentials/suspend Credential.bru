meta {
  name: suspend Credential
  type: http
  seq: 5
}

post {
  url: {{ISSUER_ADMIN_URL}}/api/admin/v1alpha/participants/{{ISSUER_CONTEXT_ID}}/credentials/:credentialId/suspend
  body: none
  auth: inherit
}

params:path {
  credentialId: <string>
}

settings {
  encodeUrl: true
}

docs {
  Suspends a credential with the given ID for the given participant. Suspended credentials will be added to the Revocation List. Suspension is reversible.
}
