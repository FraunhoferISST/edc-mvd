meta {
  name: revoke Credential
  type: http
  seq: 3
}

post {
  url: {{ISSUER_ADMIN_URL}}/api/admin/v1alpha/participants/{{ISSUER_CONTEXT_ID}}/credentials/:credentialId/revoke
  body: none
  auth: inherit
}

params:path {
  credentialId: <string>
}

settings {
  encodeUrl: true
}

docs {
  Revokes a credential with the given ID for the given participant. Revoked credentials will be added to the Revocation List
}
