meta {
  name: create Attestation
  type: http
  seq: 1
}

post {
  url: {{ISSUER_ADMIN_URL}}/api/admin/v1alpha/participants/{{ISSUER_CONTEXT_ID}}/attestations
  body: json
  auth: inherit
}

body:json {
  {
    "attestationType": "hans-peter",
    "configuration": {
      "firstName": "hans",
      "lastName": "peter"
    },
    "id": "hans-peter-attestation"
  }
}

settings {
  encodeUrl: true
}

docs {
  Creates an attestation definition in the runtime.
}
