meta {
  name: Create credential definitions
  type: http
  seq: 4
}

post {
  url: {{ISSUER_ADMIN_URL}}/api/admin/v1alpha/participants/{{ISSUER_CONTEXT_ID}}/credentialdefinitions
  body: json
  auth: inherit
}

body:json {
  {
      "attestations": [
          "db-attestation-def-1"
      ],
      "credentialType": "FoobarCredential",
      "id": "demo-credential-def-2",
      "jsonSchema": "{}",
      "jsonSchemaUrl": "https://example.com/schema/demo-credential.json",
      "mappings": [
          {
              "input": "membership_type",
              "output": "credentialSubject.membershipType",
              "required": "true"
          },
          {
              "input": "membership_start_date",
              "output": "credentialSubject.membershipStartDate",
              "required": true
          }
      ],
      "rules": [],
      "format": "VC1_0_JWT"
  }
}

settings {
  encodeUrl: true
}

